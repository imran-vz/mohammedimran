---
import { experience, getShowcaseProjectsByGroup } from '../../lib/experience';
import BrandLogo from './BrandLogo.astro';

const groups = experience.showcaseProjectGroups;
---

<section class="exp-showcase section" aria-labelledby="showcase-heading">
	<div class="section-header">
		<h2 id="showcase-heading" class="section-title">Open Source & Projects</h2>
		<span class="section-count">{String(experience.showcaseProjects.length).padStart(2, '0')}</span>
	</div>

	{groups.map((group) => {
		const projects = getShowcaseProjectsByGroup(group.id);
		if (projects.length === 0) return null;

		return (
			<div class="showcase-group">
				<h3 class="showcase-group__label">{group.label}</h3>
				<div class="showcase-grid">
					{projects.map((project) => {
						const showStatusChip =
							project.statusDisplay?.show === true && project.statusDisplay.style === 'subtle-chip';

						return (
							<a
								href={project.url}
								target="_blank"
								rel="noopener noreferrer"
								class="showcase-card"
							>
								<div class="showcase-card__top">
									<BrandLogo src={project.icon} name={project.name} variant="project" />
									<div class="showcase-card__heading">
										<h4 class="showcase-card__name">{project.name}</h4>
										{showStatusChip && (
											<span class="showcase-card__status">{project.status}</span>
										)}
									</div>
									<span class="showcase-card__arrow" aria-hidden="true">↗</span>
								</div>
								<p class="showcase-card__description">{project.description}</p>
								<div class="showcase-card__tech">
									{project.tech.map((tech) => (
										<span class="tech-tag">{tech}</span>
									))}
								</div>
							</a>
						);
					})}
				</div>
			</div>
		);
	})}
</section>

<style>
	.showcase-group {
		margin-bottom: 28px;
	}

	.showcase-group:last-child {
		margin-bottom: 0;
	}

	.showcase-group__label {
		color: var(--page-muted);
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		margin-bottom: 12px;
		text-transform: uppercase;
	}

	.showcase-grid {
		display: grid;
		gap: 12px;
		grid-template-columns: 1fr;
	}

	@media (min-width: 640px) {
		.showcase-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.showcase-card {
		border: 1px solid var(--page-line);
		border-radius: 10px;
		display: flex;
		flex-direction: column;
		padding: 14px;
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}

	.showcase-card:hover {
		border-color: #d4d4d0;
		box-shadow: 0 4px 16px rgba(55, 53, 47, 0.06);
		transform: translateY(-1px);
	}

	.showcase-card__top {
		align-items: center;
		display: flex;
		gap: 10px;
		margin-bottom: 10px;
	}

	.showcase-card__heading {
		align-items: center;
		display: flex;
		flex: 1;
		flex-wrap: wrap;
		gap: 8px;
		min-width: 0;
	}

	.showcase-card__name {
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 15px;
		font-weight: 650;
		line-height: 1.3;
	}

	.showcase-card__status {
		background: var(--page-soft);
		border-radius: 4px;
		color: var(--page-muted);
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 10px;
		font-weight: 500;
		line-height: 1.2;
		padding: 3px 7px;
		white-space: nowrap;
	}

	.showcase-card__arrow {
		align-self: flex-start;
		color: var(--page-muted);
		font-size: 14px;
		transition: transform 0.18s ease;
	}

	.showcase-card:hover .showcase-card__arrow {
		transform: translate(2px, -2px);
	}

	.showcase-card__description {
		color: var(--page-muted);
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 13px;
		line-height: 1.6;
		margin-bottom: 10px;
	}

	.showcase-card__tech {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		margin-top: auto;
	}

	.tech-tag {
		background: var(--page-soft);
		border-radius: 5px;
		color: var(--page-muted);
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 10px;
		padding: 2px 5px;
	}
</style>
