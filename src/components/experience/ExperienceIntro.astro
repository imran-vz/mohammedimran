---
import { experience } from '../../lib/experience';

const { profile } = experience;
---

<section class="exp-intro" aria-labelledby="profile-name">
	<p class="exp-intro__eyebrow">{profile.location} · Remote-friendly</p>
	<h1 id="profile-name" class="exp-intro__name">{profile.preferredName ?? profile.name}</h1>
	<p class="exp-intro__headline">{profile.displayHeadline} building things that ship.</p>
	<p class="exp-intro__subheadline">{profile.supportingHeadline}</p>
</section>

<style>
	.exp-intro {
		border-bottom: 1px solid var(--page-line);
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		margin-bottom: 8px;
		padding-bottom: 36px;
	}

	.exp-intro__eyebrow {
		color: var(--page-muted);
		font-size: 13px;
		line-height: 1.5;
		margin-bottom: 10px;
	}

	.exp-intro__name {
		font-size: clamp(2rem, 5vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 14px;
	}

	.exp-intro__headline {
		color: var(--page-ink);
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.5;
		margin-bottom: 8px;
	}

	.exp-intro__subheadline {
		color: var(--page-muted);
		font-size: 15px;
		line-height: 1.65;
		max-width: 540px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.exp-intro > * {
			animation: exp-in 0.5s ease both;
		}

		.exp-intro > :nth-child(2) {
			animation-delay: 0.06s;
		}

		.exp-intro > :nth-child(3) {
			animation-delay: 0.12s;
		}

		.exp-intro > :nth-child(4) {
			animation-delay: 0.18s;
		}
	}

	@keyframes exp-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 700px) {
		.exp-intro {
			padding-bottom: 28px;
		}
	}
</style>
