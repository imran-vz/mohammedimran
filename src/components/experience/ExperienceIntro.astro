---
import { experience } from '../../lib/experience';

const { profile } = experience;
---

<section class="exp-intro" aria-labelledby="profile-name">
	<p class="exp-intro__eyebrow">{profile.location} · Remote-friendly</p>
	<h1 id="profile-name" class="exp-intro__name">
		{profile.preferredName ?? profile.name}
		<svg class="exp-intro__underline" viewBox="0 0 200 12" width="200" height="12" preserveAspectRatio="none" aria-hidden="true">
			<path d="M3 9 C 50 3, 90 11, 197 5" fill="none" stroke="#ffd60a" stroke-width="5" stroke-linecap="round" />
		</svg>
	</h1>
	<p class="exp-intro__headline">
		<span class="exp-intro__hl">{profile.displayHeadline}</span>{" "}
		building things that ship.
	</p>
	<p class="exp-intro__subheadline">
		<span class="exp-intro__hl exp-intro__hl--soft">5+ years</span> of full-stack work across backend
		platforms, IoT systems, AI assistants, data pipelines, and customer engagement tools.
	</p>
</section>

<style>
	.exp-intro {
		padding-bottom: 36px;
		border-bottom: 1px solid var(--page-line);
		margin-bottom: 8px;
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	.exp-intro__eyebrow {
		color: var(--page-muted);
		font-size: 13px;
		line-height: 1.5;
		margin-bottom: 10px;
	}

	.exp-intro__name {
		position: relative;
		display: inline-block;
		font-size: clamp(2rem, 5vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 14px;
	}

	.exp-intro__underline {
		position: absolute;
		left: 0;
		bottom: -8px;
		width: 100%;
		height: 12px;
		overflow: visible;
	}

	.exp-intro__underline path {
		stroke-dasharray: 220;
		stroke-dashoffset: 220;
		animation: exp-draw 0.7s ease-out 0.15s forwards;
	}

	@keyframes exp-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	.exp-intro__headline {
		color: var(--page-ink);
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.5;
		margin-bottom: 8px;
	}

	.exp-intro__subheadline {
		color: var(--page-muted);
		font-size: 15px;
		line-height: 1.65;
		max-width: 540px;
	}

	.exp-intro__hl {
		position: relative;
		white-space: nowrap;
	}

	.exp-intro__hl::before {
		content: '';
		position: absolute;
		inset: -2px -4px;
		background: #ffe94d;
		z-index: -1;
		transform: scaleX(0);
		transform-origin: left center;
		border-radius: 3px;
		animation: exp-sweep 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
	}

	.exp-intro__hl--soft::before {
		background: #fff3a3;
		animation-delay: 0.9s;
	}

	@keyframes exp-sweep {
		to {
			transform: scaleX(1);
		}
	}

	@media (max-width: 700px) {
		.exp-intro {
			padding-bottom: 28px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.exp-intro__underline path,
		.exp-intro__hl::before {
			animation: none;
		}

		.exp-intro__underline path {
			stroke-dashoffset: 0;
		}

		.exp-intro__hl::before {
			transform: scaleX(1);
		}
	}
</style>
