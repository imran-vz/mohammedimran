---
import { getInitials } from '../../lib/experience';

interface Props {
	src?: string;
	name: string;
	variant?: 'company' | 'project';
	class?: string;
}

const { src, name, variant = 'company', class: className = '' } = Astro.props;
const initials = getInitials(name);
---

<span class:list={['brand-logo', `brand-logo--${variant}`, className]}>
	{
		src && (
			<img
				class="brand-logo__img"
				src={src}
				alt={`${name} logo`}
				loading="lazy"
				decoding="async"
				onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
			/>
		)
	}
	<span class="brand-logo__fallback" style={src ? 'display:none' : undefined} aria-hidden={src ? 'true' : undefined}>
		{initials}
	</span>
</span>

<style>
	.brand-logo {
		align-items: center;
		background: var(--page-bg);
		border: 1px solid var(--page-line);
		display: inline-flex;
		flex: none;
		justify-content: center;
		overflow: hidden;
		position: relative;
	}

	.brand-logo--company {
		border-radius: 7px;
		height: 32px;
		width: 32px;
	}

	.brand-logo--project {
		border-radius: 9px;
		height: 40px;
		width: 40px;
	}

	.brand-logo__img {
		display: block;
		height: 100%;
		object-fit: contain;
		padding: 3px;
		width: 100%;
	}

	.brand-logo--company .brand-logo__img {
		border-radius: 5px;
	}

	.brand-logo--project .brand-logo__img {
		border-radius: 6px;
	}

	.brand-logo__fallback {
		align-items: center;
		color: var(--page-muted);
		display: flex;
		font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 12px;
		font-weight: 700;
		height: 100%;
		justify-content: center;
		letter-spacing: 0.01em;
		width: 100%;
	}

	.brand-logo--project .brand-logo__fallback {
		font-size: 14px;
	}
</style>
