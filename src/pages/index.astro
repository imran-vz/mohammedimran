---
import imranWebp from '../assets/imran.webp';
import ActivityGraph from '../components/experience/ActivityGraph.astro';
import ExperienceIntro from '../components/experience/ExperienceIntro.astro';
import PersonalNote from '../components/experience/PersonalNote.astro';
import ShowcaseProjects from '../components/experience/ShowcaseProjects.astro';
import SkillsMatrix from '../components/experience/SkillsMatrix.astro';
import WorkTimeline from '../components/experience/WorkTimeline.astro';
import { siteMeta } from '../config/siteMeta';
import Layout from '../layouts/Layout.astro';

// SEO Configuration
const seo = {
	title: 'Imran | Full Stack Developer for Hire in Bangalore | React, TypeScript, Go',
	description:
		'Imran is a senior full stack developer for hire in Bangalore/Bengaluru with 5+ years of React, TypeScript, Go, and Rust experience. Available for freelance and contract work.',
	image: siteMeta.ogImage,
	url: siteMeta.siteUrl,
	keywords:
		'Imran, Mohammed Imran, developer for hire Bangalore, full stack developer Bangalore, React developer Bangalore, TypeScript developer Bangalore, Go developer Bangalore, Bengaluru Developer, Senior Developer India, imran-vz, Web Developer, Software Engineer',
};

const professionalServiceSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	image: imranWebp.src,
	name: 'Imran - Full Stack Development',
	description: 'Full Stack Development services in Bangalore/Bengaluru specializing in React, TypeScript, Go, and Rust',
	url: siteMeta.siteUrl,
	areaServed: [
		{ '@type': 'City', name: 'Bengaluru' },
		{ '@type': 'City', name: 'Bangalore' },
		{ '@type': 'Place', name: 'Worldwide (Remote)' },
	],
	serviceType: ['Web Development', 'Full Stack Development', 'Software Engineering', 'Technical Leadership'],
};

const agentDiscoveryLinks = [
	'</.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"',
	'</.well-known/openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json"',
	'</auth.md>; rel="service-doc"; type="text/markdown"',
	'</.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"',
	'</sitemap-index.xml>; rel="describedby"; type="application/xml"',
];

Astro.response.headers.set('Link', agentDiscoveryLinks.join(', '));
---

<Layout
    title={seo.title}
    description={seo.description}
    image={seo.image}
    canonical={seo.url}
>
    <Fragment slot="head">
    <meta name="title" content={seo.title} />
    <meta name="keywords" content={seo.keywords} />
    <meta name="twitter:image:alt" content="Imran - Full Stack Developer" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Bengaluru" />
    <meta name="geo.position" content="12.9716;77.5946" />
    <meta name="ICBM" content="12.9716, 77.5946" />
    <script type="application/ld+json" set:html={JSON.stringify(professionalServiceSchema)} />
    </Fragment>

    <main id="main-content">
        <ExperienceIntro />
        <WorkTimeline />
        <ActivityGraph />
        <ShowcaseProjects />
        <SkillsMatrix />
        <PersonalNote />
    </main>
</Layout>
